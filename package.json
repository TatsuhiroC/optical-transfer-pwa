{
  "name": "optical-transfer-pwa",
  "private": true,
  "version": "2.0.3",
  "license": "MIT",
  "description": "PWA: file transfer between two devices using fountain-coded animated QR codes \u2014 screen to camera, no network. One app, send and receive.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "android:sync": "npm run build && node scripts/sync-android.mjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:keystore": "bash scripts/make-keystore.sh",
    "android:assets": "node scripts/android-assets.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "zxing-wasm": "^3.1.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
